# Supabase (obligatorio para backend en línea)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima

# Notificaciones push (FCM). Ponlo en true SOLO después de copiar
# google-services.json a android/app/ (sin ese archivo la app se cierra al registrar).
VITE_PUSH_HABILITADO=false

# Google Maps (la misma clave que usaba la versión Expo). Se usa en Android/iOS (SDK nativo)
# y en web (Maps JavaScript API). Sin clave, el mapa cae a OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=tu_api_key_google_maps
