# Supabase (obligatorio para backend en línea)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima

# Notificaciones push (FCM). Ponlo en true SOLO después de copiar
# google-services.json a android/app/ (sin ese archivo la app se cierra al registrar).
VITE_PUSH_HABILITADO=false

# Google Maps para la app Android/iOS (SDK nativo). Es la misma clave de la versión Expo.
VITE_GOOGLE_MAPS_API_KEY=tu_api_key_google_maps

# Opcional: clave aparte para el navegador (`npm run dev`), con Maps JavaScript API y
# restricción de referente http://localhost:5173/*. Sin ella, en web se usa OpenStreetMap.
VITE_GOOGLE_MAPS_WEB_API_KEY=
